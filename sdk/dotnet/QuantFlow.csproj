<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package metadata -->
    <PackageId>QuantFlow.Sdk</PackageId>
    <Version>0.3.2</Version>
    <Authors>QuantFlow Team</Authors>
    <Company>quantflow</Company>
    <Description>quantflow SDK for C#/.NET trading bots - configuration parsing, metric emission, and structured logging</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/quantflow-io/quantflow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/quantflow-io/quantflow.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryDirectory>sdk/dotnet</RepositoryDirectory>
    <PackageTags>quantflow;trading;bot;algorithmic-trading;sdk;dotnet;csharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- GitHub Packages publishing -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.1" />
  </ItemGroup>

  <!-- Exclude test files from main project -->
  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
